# ==============================================================================
# Ask Abir AI - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and fill in your actual private credentials.
# NEVER commit your real '.env' file to source control.
# ==============================================================================

# Required: Your free Google Gemini API key from https://aistudio.google.com/app/apikey
# Server-side ONLY: Do NOT prefix with VITE_ to keep it private from browser bundles.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Gemini Model identifier (defaults to 'gemini-3.8-flash' if unset)
# Supported free tier options:
# - gemini-3.8-flash (Recommended: fast, high quality, free tier)
# - gemini-flash-latest (Always routes to current stable flash)
GEMINI_MODEL=gemini-3.8-flash
